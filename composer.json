{
    "name": "enaxon/rtly-kit",
    "description": "Dates, numbers and checks for Persian and Arabic PHP apps: Jalali, Hijri and Hebrew calendars, Iranian validators, number words, holidays and prayer times. No required dependencies.",
    "type": "library",
    "keywords": [
        "rtl",
        "jalali",
        "hijri",
        "hebrew",
        "persian",
        "arabic",
        "calendar",
        "datetime",
        "carbon",
        "validation",
        "iran",
        "prayer-times",
        "shamsi",
        "umm-al-qura"
    ],
    "homepage": "https://github.com/ehsanenaloo/RTLY-Kit",
    "license": "MIT",
    "authors": [
        {
            "name": "Ehsan Enaloo",
            "homepage": "https://github.com/ehsanenaloo"
        }
    ],
    "support": {
        "issues": "https://github.com/ehsanenaloo/RTLY-Kit/issues",
        "source": "https://github.com/ehsanenaloo/RTLY-Kit",
        "security": "https://github.com/ehsanenaloo/RTLY-Kit/security/policy"
    },
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "illuminate/config": "^11.0||^12.0||^13.0",
        "illuminate/container": "^11.0||^12.0||^13.0",
        "illuminate/database": "^11.0||^12.0||^13.0",
        "illuminate/support": "^11.0||^12.0||^13.0",
        "illuminate/translation": "^11.0||^12.0||^13.0",
        "illuminate/validation": "^11.0||^12.0||^13.0",
        "infection/infection": "^0.32.6",
        "nesbot/carbon": "^3.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0"
    },
    "suggest": {
        "nesbot/carbon": "For Carbon macros (toJalali, jformat, createFromJalali, ...)",
        "illuminate/support": "For Laravel auto-discovery: service provider, Jalali facade, validation rules and the JalaliCast Eloquent cast"
    },
    "autoload": {
        "psr-4": {
            "RtlyKit\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "RtlyKit\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit -c tools/phpunit.xml.dist",
        "coverage": "php -d pcov.enabled=1 -d pcov.directory=src vendor/bin/phpunit -c tools/phpunit.xml.dist --coverage-text",
        "phpstan": "phpstan analyse -c tools/phpstan.neon --memory-limit=1G",
        "cs": "php-cs-fixer fix --config=tools/php-cs-fixer.dist.php --dry-run --diff --ansi",
        "mutation": "php -d memory_limit=-1 -d pcov.enabled=1 -d pcov.directory=src vendor/bin/infection --configuration=tools/infection.json5 --threads=8 --no-progress --with-uncovered --only-covering-test-cases",
        "cs-fix": "php-cs-fixer fix --config=tools/php-cs-fixer.dist.php --ansi",
        "docs": "php tools/docs/build.php",
        "docs:check": "php tools/docs/build.php --check",
        "check": [
            "@phpstan",
            "@test",
            "@cs"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "allow-plugins": {
            "infection/extension-installer": false
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "RtlyKit\\Laravel\\RtlyKitServiceProvider"
            ],
            "aliases": {
                "Jalali": "RtlyKit\\Laravel\\Facades\\Jalali"
            }
        }
    }
}
